<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- فاز ۵: برای نمایش نوتیفیکیشن یادآوری پیگیری (اجباری از اندروید ۱۳/API 33 به بعد) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RealEstateApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RealEstateConsultant">

        <!--
          کلید API نقشه گوگل: از Google Cloud Console یک کلید برای «Maps SDK for Android» بساز
          و اینجا جایگزین YOUR_GOOGLE_MAPS_API_KEY کن. تا قبل از اون، صفحات نقشه به‌جای نقشه واقعی
          خطا نشون می‌دن.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- WorkManager به‌صورت دستی با HiltWorkerFactory در RealEstateApp پیکربندی می‌شود؛
             initializer پیش‌فرض باید غیرفعال شود وگرنه با خطا کرش می‌کند. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- فاز ۵: برای اشتراک‌گذاری امن فایل‌های PDF/Excel خروجی‌گرفته‌شده، بدون مجوز حافظه -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RealEstateConsultant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
